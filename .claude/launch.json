{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wishly",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "wishly",
        "run",
        "dev",
        "--",
        "--port",
        "5179",
        "--strictPort"
      ],
      "port": 5179
    },
    {
      "name": "wishly-ios-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "wishly-ios",
        "run",
        "web",
        "--",
        "--port",
        "8099"
      ],
      "port": 8099
    },
    {
      "name": "wishly-backend-local",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd wishly-ios && base44 dev --port 4400"
      ],
      "port": 4400
    }
  ]
}
