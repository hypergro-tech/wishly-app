# Copy to .env.local and fill in. Without an app ID the app runs as an on-device demo.

# Your Base44 app ID: base44/.app.jsonc after `base44 create`, or the part of the
# editor URL between /apps/ and /editor/.
EXPO_PUBLIC_BASE44_APP_ID=

# Your Base44 app's web address, e.g. https://your-app.base44.app. Needed for
# Continue with Apple / Google (they use Base44's web sign-in).
EXPO_PUBLIC_BASE44_APP_URL=

# Optional. Where Base44 sends people back after Apple / Google sign-in. Leave
# empty to use the app's own link (wishly://auth). If Base44 only accepts https,
# point this at a page on the web app that forwards to wishly://auth with the
# same query string.
EXPO_PUBLIC_AUTH_REDIRECT_URL=

# Where the web app is hosted. Gift links sent to recipients open here.
EXPO_PUBLIC_GIFT_BASE_URL=

# Set to true to keep the "Demo only" buttons (finish song, apply correction)
# while testing against Base44 before the real song pipeline exists.
EXPO_PUBLIC_DEMO_TOOLS=

# Your terms and privacy policy pages, linked from the sign-in sheet. The App
# Store needs a privacy policy before review.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Set to true once the makeSong and suggestSpelling functions are deployed and
# GEMINI_API_KEY and OPENAI_API_KEY are set as Base44 secrets. The backend then
# sings each song and checks the name was heard before it's ready.
EXPO_PUBLIC_REAL_SONGS=
