// A song gift. Shared by the Wishly iOS app and the web app.
// Push with `base44 entities push` (see README).
{
  "name": "Order",
  "type": "object",
  "title": "Order",
  "description": "A personal song gift: the brief, the song, corrections and the gift link",
  "properties": {
    // status, song, song_version, name_check and gift_token are written only by
    // the backend functions (startSong, makeSong, approveSong), which run with
    // full access. A buyer can't set them, even on their own order: otherwise
    // they could approve an unchecked song or put any audio behind a gift link.
    "status": {
      "type": "string",
      "enum": ["in_production", "ready_for_review", "correction_requested", "approved"],
      "default": "in_production",
      "rls": { "write": false }
    },
    "recipient": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "pronunciation": { "type": "string", "maxLength": 80 }, // the sounds-like spelling that gets sung
        "pronouns": { "type": "string" },
        "relationship": { "type": "string" }
      },
      "required": ["name"]
    },
    "occasion": { "type": "string" },
    "occasion_date": { "type": "string" },
    "memories": {
      "type": "object",
      "properties": {
        "ritual": { "type": "string", "maxLength": 600 },
        "nickname": { "type": "string", "maxLength": 80 },
        "inside_joke": { "type": "string", "maxLength": 600 },
        "memory": { "type": "string", "maxLength": 600 },
        "want_to_say": { "type": "string", "maxLength": 600 },
        "avoid": { "type": "string", "maxLength": 300 }
      }
    },
    "music": {
      "type": "object",
      "properties": {
        "mood": { "type": "string" },
        "genre": { "type": "string" },
        "voice": { "type": "string" },
        "language": { "type": "string" }
      }
    },
    "package": {
      "type": "object",
      "properties": {
        "delivery": { "type": "string", "enum": ["standard", "express"], "default": "standard" },
        "extras": { "type": "array", "items": { "type": "string" } }
      }
    },
    "buyer": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      }
    },
    "price_total": { "type": "number", "minimum": 0 },
    "ready_by": { "type": "string" },
    "song": {
      "type": "object",
      "rls": { "write": false },
      "properties": {
        "title": { "type": "string" },
        "style": { "type": "string" },
        // Sound tags the singer was given, e.g. "acoustic pop, warm female vocal, 86 bpm".
        "style_tags": { "type": "string" },
        "duration_sec": { "type": "number" },
        // null while a new version is being made.
        "audio_url": { "type": ["string", "null"] },
        // The spelling the singer was given, e.g. "Shivawn" for Siobhan.
        "sung_as": { "type": "string" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "lines": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "song_version": { "type": "integer", "minimum": 0, "default": 0, "rls": { "write": false } },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string" },
          "note": { "type": "string" },
          "changes": { "type": "object" },
          "at": { "type": "string" },
          "resolved": { "type": "boolean" }
        }
      }
    },
    // Set by the makeSong function: each spelling sung and how many of three
    // listens heard the name. needs_person: no try passed, so someone listens first.
    "name_check": {
      "type": "object",
      "rls": { "write": false },
      "properties": {
        "passed": { "type": "boolean" },
        "needs_person": { "type": "boolean" },
        "error": { "type": "string" },
        "tries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "spelling": { "type": "string" }, "heard": { "type": "integer" }, "refused": { "type": "boolean" } }
          }
        }
      }
    },
    "gift_token": { "type": "string", "rls": { "write": false } },
    "gift": {
      "type": "object",
      "properties": {
        "message": { "type": "string", "maxLength": 1000 },
        "from_name": { "type": "string" },
        "opened_count": { "type": "integer", "minimum": 0 }
      }
    },
    // The buyer's thumbs up or down on the song (src/api/feedbackApi.ts); null when cleared.
    "feedback": {
      "type": ["object", "null"],
      "properties": {
        "rating": { "type": "string", "enum": ["LIKE", "DISLIKE"] },
        "reason": { "type": "string", "maxLength": 300 },
        "version": { "type": "integer" },
        "at": { "type": "string" }
      }
    }
  },
  "required": ["recipient", "occasion"],
  // Buyers see and change only their own orders. Recipients never read this
  // entity directly: the gift page should fetch through a backend function
  // that returns only the song and message for a valid gift_token.
  "rls": {
    "create": true,
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}
