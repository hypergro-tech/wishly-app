{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "simulator": {
      "environment": "production",
      "ios": {
        "simulator": true
      },
      "channel": "simulator"
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6834450274",
        "appleTeamId": "G5MDAX84U7",
        "ascApiKeyPath": "$ASC_API_KEY_PATH",
        "ascApiKeyIssuerId": "$ASC_API_KEY_ISSUER_ID",
        "ascApiKeyId": "$ASC_API_KEY_ID"
      }
    }
  }
}
